global:
  resolve_timeout: 5m

route:
  receiver: "telegram-default"
  group_by: ["alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: "telegram-default"
    telegram_configs:
      - bot_token: "{{ vault_telegram_bot_token }}"
        chat_id: {{ vault_telegram_chat_id }}
        parse_mode: "HTML"
